{{~ if use_grid_steps ~}}
new {{ simple_name profile.classes.gridSteps }}(winDriver).clickCell({{ row }}, {{ column }});
new Actions(winDriver).doubleClick().perform();
{{~ else if cell ~}}
new Actions(winDriver).doubleClick({{ target }}.findElement(By.xpath({{ cell }}))).perform();
{{~ else ~}}
new Actions(winDriver).doubleClick({{ target }}).perform();
{{~ end ~}}
