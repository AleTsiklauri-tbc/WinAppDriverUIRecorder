<UserControl x:Class="Recorder.App.Views.LocatorCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources"
             xmlns:vm="clr-namespace:Recorder.App.ViewModels"
             AutomationProperties.AutomationId="Locators">
    <!-- DataContext: LocatorsViewModel -->
    <UserControl.Resources>
        <DataTemplate x:Key="NoteTemplate">
            <DockPanel Margin="0,3,0,0">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,2,6,0" VerticalAlignment="Top"
                           Foreground="{Binding Source={x:Static vm:LocatorQuality.Medium}, Converter={StaticResource QualityBrush}}" Text="&#xE7BA;" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="InfoTemplate">
            <DockPanel Margin="0,3,0,0">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,2,6,0" VerticalAlignment="Top" Text="&#xE946;" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Locator_Checking}" AutomationProperties.AutomationId="Locator.Checking">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:LocatorsState.Checking}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- The chosen (at first: best) locator -->
        <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="Locator.Card">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Locator_Stability_Tip}">
                        <Border Width="6" Height="10" Margin="0,0,2,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{Binding Selected.Quality, Converter={StaticResource QualityBrush}}"
                                Opacity="{Binding Selected.StabilityLevel, Converter={StaticResource LevelOpacity}, ConverterParameter=1}" />
                        <Border Width="6" Height="13" Margin="0,0,2,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{Binding Selected.Quality, Converter={StaticResource QualityBrush}}"
                                Opacity="{Binding Selected.StabilityLevel, Converter={StaticResource LevelOpacity}, ConverterParameter=2}" />
                        <Border Width="6" Height="16" Margin="0,0,6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{Binding Selected.Quality, Converter={StaticResource QualityBrush}}"
                                Opacity="{Binding Selected.StabilityLevel, Converter={StaticResource LevelOpacity}, ConverterParameter=3}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Text="{Binding Selected.StabilityText}"
                                   AutomationProperties.AutomationId="Locator.Stability" />
                    </StackPanel>
                    <Border Style="{StaticResource BadgeBorderStyle}" Background="{Binding Selected.Quality, Converter={StaticResource QualityBrush}}">
                        <TextBlock Text="{Binding Selected.Badge}" AutomationProperties.AutomationId="Locator.Badge" />
                    </Border>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SelectedTitle}" />
                </DockPanel>

                <TextBox Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}" FontSize="13"
                         Text="{Binding Selected.Value, Mode=OneWay}"
                         AutomationProperties.Name="{Binding SelectedTitle}"
                         AutomationProperties.AutomationId="Locator.Value" />

                <!-- The text carries the ✓/✗, so the count is not colour-only (spec 11.2). -->
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding Selected.MatchText}" AutomationProperties.AutomationId="Locator.Matches" />
                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,6,0,0" Text="{Binding Selected.Explanation}"
                           AutomationProperties.AutomationId="Locator.Explanation" />
                <ItemsControl ItemsSource="{Binding Selected.Warnings}" Focusable="False" ItemTemplate="{StaticResource NoteTemplate}"
                              AutomationProperties.AutomationId="Locator.Warnings" />
                <ItemsControl ItemsSource="{Binding Selected.Infos}" Focusable="False" ItemTemplate="{StaticResource InfoTemplate}"
                              AutomationProperties.AutomationId="Locator.Infos" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" Text="{Binding Selected.VerifyText}"
                           Visibility="{Binding Selected.VerifyText, Converter={StaticResource ToVisibility}}"
                           AutomationProperties.AutomationId="Locator.Verified" />

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="0,12,0,4" Text="{x:Static res:Strings.Locator_JavaLine}" />
                <TextBox IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                         Text="{Binding JavaLine, Mode=OneWay}"
                         AutomationProperties.Name="{x:Static res:Strings.Locator_JavaLine}"
                         AutomationProperties.AutomationId="Locator.JavaLine" />

                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,6" Content="{x:Static res:Strings.Locator_CopyJava}"
                            Command="{Binding CopyJavaLineCommand}" ToolTip="{x:Static res:Strings.Locator_CopyJava_Tip}"
                            AutomationProperties.AutomationId="Locator.CopyJava" />
                    <Button Margin="0,0,6,6" Content="{x:Static res:Strings.Locator_CopyValue}" Command="{Binding CopyValueCommand}"
                            ToolTip="{x:Static res:Strings.Locator_CopyValue_Tip}" AutomationProperties.AutomationId="Locator.CopyValue" />
                    <Button Margin="0,0,6,6" Content="{x:Static res:Strings.Locator_Highlight}" Command="{Binding HighlightMatchesCommand}"
                            ToolTip="{x:Static res:Strings.Locator_Highlight_Tip}" AutomationProperties.AutomationId="Locator.Highlight" />
                    <Button Margin="0,0,6,6" Content="{x:Static res:Strings.Verify_Button}" Command="{Binding VerifyCommand}"
                            ToolTip="{x:Static res:Strings.Verify_Button_Tip}" AutomationProperties.AutomationId="Locator.Verify" />
                    <Button Margin="0,0,6,6" Content="{x:Static res:Strings.Locator_CheckAgain}" Command="{Binding CheckAgainCommand}"
                            ToolTip="{x:Static res:Strings.Locator_CheckAgain_Tip}" AutomationProperties.AutomationId="Locator.CheckAgain" />
                </WrapPanel>

                <StackPanel Margin="0,4,0,0" Visibility="{Binding VerifyPanel.IsVisible, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="Locator.VerifyPanel">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.Verify_Address}" />
                    <TextBox Margin="0,4,0,0" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding VerifyPanel.Address, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.Verify_Address}" AutomationProperties.AutomationId="Locator.Address">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding VerifyPanel.SaveAddressCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,6,0,0" Text="{Binding VerifyPanel.Status}"
                               AutomationProperties.AutomationId="Locator.VerifyStatus" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="{StaticResource Radius}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource ToVisibility}}">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding StatusMessage}" AutomationProperties.AutomationId="Locator.Status" />
        </Border>

        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Static res:Strings.Locator_OthersTitle}"
                   Visibility="{Binding Others.Count, Converter={StaticResource ToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Others}" Focusable="False" AutomationProperties.AutomationId="Locator.Others">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,10">
                        <RadioButton DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,4,0" MinWidth="0"
                                     IsChecked="{Binding IsChosen, Mode=TwoWay}" ToolTip="{x:Static res:Strings.Locator_Choose_Tip}"
                                     AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AutomationId="Locator.Choose" />
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}" Text="{Binding MatchText}" />
                                <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left" Background="{Binding Quality, Converter={StaticResource QualityBrush}}">
                                    <TextBlock Text="{Binding Badge}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Style="{StaticResource MonoTextStyle}" Margin="0,4,0,0" FontSize="12" Text="{Binding Value}" />
                            <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False" ItemTemplate="{StaticResource NoteTemplate}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding VerifyText}"
                                       Visibility="{Binding VerifyText, Converter={StaticResource ToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
