<UserControl x:Class="Recorder.App.Views.StepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources">
    <!-- DataContext: StepsViewModel (spec 11.2). -->
    <Grid>
        <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="{Binding [Steps_Empty], Source={StaticResource Shortcuts}}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="Steps.Empty" />
        <ListBox x:Name="StepsList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                 BorderThickness="0" Margin="0,4,0,0" AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding IsEmpty, Converter={StaticResource ToCollapsedVisibility}}"
                 SelectionChanged="OnSelectionChanged"
                 PreviewMouseLeftButtonDown="OnPreviewMouseDown" PreviewMouseMove="OnPreviewMouseMove" Drop="OnDrop"
                 ToolTip="{x:Static res:Strings.Steps_Moves_Tip}" ToolTipService.InitialShowDelay="1500"
                 AutomationProperties.Name="{x:Static res:Strings.Steps_Tab}"
                 AutomationProperties.HelpText="{x:Static res:Strings.Steps_Moves_Tip}"
                 AutomationProperties.AutomationId="Steps.List">
            <ListBox.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
                <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
                <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource ToCollapsedVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Width="24" Margin="0,0,4,0" TextAlignment="Right" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Number}" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconTextStyle}" Margin="0,2,8,0" VerticalAlignment="Top" Text="{Binding Glyph}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0"
                                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource SubtleButtonStyle}" Padding="4,2"
                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        ToolTip="{x:Static res:Strings.Step_Edit_Tip}"
                                        AutomationProperties.Name="{x:Static res:Strings.Step_Edit}" AutomationProperties.AutomationId="Step.Edit">
                                    <TextBlock Style="{StaticResource IconTextStyle}" FontSize="12" Text="&#xE70F;" />
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Padding="4,2"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        ToolTip="{x:Static res:Strings.Step_Delete_Tip}"
                                        AutomationProperties.Name="{x:Static res:Strings.Step_Delete}" AutomationProperties.AutomationId="Step.Delete">
                                    <TextBlock Style="{StaticResource IconTextStyle}" FontSize="12" Text="&#xE74D;" />
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconTextStyle}" Margin="6,2,0,0" VerticalAlignment="Top" FontSize="12"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="&#xE7BA;" ToolTip="{Binding WarningText}"
                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" AutomationProperties.AutomationId="Step.Sentence" />
                                <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left" Margin="0,3,0,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding VariableName, Converter={StaticResource ToVisibility}}">
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding VariableName}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Sentence}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,2" Text="{Binding EditTextLabel}" />
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="OnEditorVisible"
                                     AutomationProperties.Name="{Binding EditTextLabel}" AutomationProperties.AutomationId="Step.EditText">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding DataContext.CommitEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <KeyBinding Key="Escape" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Visibility="{Binding EditsRow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,2" Text="{x:Static res:Strings.Step_EditRow}" />
                                <TextBox Text="{Binding EditRow, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static res:Strings.Step_EditRow}" AutomationProperties.AutomationId="Step.EditRow">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding DataContext.CommitEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <KeyBinding Key="Escape" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <CheckBox Margin="0,6,0,0" Content="{Binding EditStateLabel}" IsChecked="{Binding EditState}"
                                      Visibility="{Binding EditsState, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.AutomationId="Step.EditState" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <Button Content="{x:Static res:Strings.Step_EditSave}" Padding="10,3"
                                        Command="{Binding DataContext.CommitEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="Step.EditSave" />
                                <Button Content="{x:Static res:Strings.Step_EditCancel}" Padding="10,3" Margin="6,0,0,0"
                                        Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="Step.EditCancel" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Sentence}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibleName}" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="{Binding WarningText}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
