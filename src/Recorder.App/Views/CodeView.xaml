<UserControl x:Class="Recorder.App.Views.CodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources"
             xmlns:controls="clr-namespace:Recorder.App.Controls"
             xmlns:vm="clr-namespace:Recorder.App.ViewModels"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             AutomationProperties.AutomationId="Code">
    <!-- DataContext: CodeViewModel. Spec 10.4: Page objects (one per page), Steps, Test and Selected element, live. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8,8,0">
            <ComboBox DockPanel.Dock="Right" MinWidth="150" MaxWidth="220"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"
                      ToolTip="{x:Static res:Strings.Code_Profile_Tip}"
                      AutomationProperties.Name="{x:Static res:Strings.Code_Profile}"
                      AutomationProperties.AutomationId="Code.Profile">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <TextBlock Style="{StaticResource PaneHeaderTextStyle}" Margin="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Code_Title}" />
        </DockPanel>

        <!-- The tab strip only: every tab shows its code in the one editor below. -->
        <TabControl DockPanel.Dock="Top" Margin="8,8,8,0" SelectedIndex="{Binding SelectedTab, Converter={StaticResource EnumToIndex}}"
                    AutomationProperties.AutomationId="Code.Tabs">
            <TabItem Header="{x:Static res:Strings.Code_Tab_Pages}" AutomationProperties.AutomationId="Code.Tab.Pages" />
            <TabItem Header="{x:Static res:Strings.Code_Tab_Steps}" AutomationProperties.AutomationId="Code.Tab.Steps"
                     Visibility="{Binding HasStepsLayer, Converter={StaticResource BoolToVisibility}}" />
            <TabItem Header="{x:Static res:Strings.Code_Tab_Test}" AutomationProperties.AutomationId="Code.Tab.Test" />
            <TabItem Header="{x:Static res:Strings.Code_Tab_Element}" AutomationProperties.AutomationId="Code.Tab.Element" />
        </TabControl>

        <WrapPanel DockPanel.Dock="Bottom" Margin="8,8,8,8">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,6" Content="{x:Static res:Strings.Code_Copy}" Command="{Binding CopyCommand}"
                    ToolTip="{x:Static res:Strings.Code_Copy_Tip}" AutomationProperties.AutomationId="Code.Copy" />
            <Button Margin="0,0,6,6" Content="{x:Static res:Strings.Code_SaveAs}" Command="{Binding SaveAsCommand}"
                    ToolTip="{x:Static res:Strings.Code_SaveAs_Tip}" AutomationProperties.AutomationId="Code.SaveAs" />
            <Button Margin="0,0,6,6" Content="{x:Static res:Strings.Code_Merge}" Command="{Binding MergeCommand}"
                    ToolTip="{x:Static res:Strings.Code_Merge_Tip}" AutomationProperties.AutomationId="Code.Merge" />
            <Button Margin="0,0,6,6" Style="{StaticResource SubtleButtonStyle}" Content="{x:Static res:Strings.Code_EditProfile}"
                    Command="{Binding EditProfileCommand}"
                    ToolTip="{x:Static res:Strings.Code_EditProfile_Tip}" AutomationProperties.AutomationId="Code.EditProfile" />
        </WrapPanel>

        <StackPanel DockPanel.Dock="Top" Margin="12,8,8,0">
            <ComboBox ItemsSource="{Binding FileNames}" SelectedItem="{Binding SelectedFileName}" Margin="0,0,0,6"
                      Visibility="{Binding HasFilePicker, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="{x:Static res:Strings.Code_Class}"
                      AutomationProperties.AutomationId="Code.File" />
            <DockPanel Margin="0,0,0,6" Visibility="{Binding IsPagesTab, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static res:Strings.Code_ClassName}" />
                <TextBox x:Name="ClassNameBox" FontFamily="{StaticResource MonoFontFamily}"
                         Text="{Binding EditableClassName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding EditableClassName, Converter={StaticResource ToBool}}"
                         LostKeyboardFocus="OnClassNameLostFocus"
                         ToolTip="{x:Static res:Strings.Code_ClassName_Tip}"
                         AutomationProperties.Name="{x:Static res:Strings.Code_ClassName}"
                         AutomationProperties.AutomationId="Code.ClassName">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CommitClassNameCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <Border Padding="8,6" CornerRadius="{StaticResource Radius}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding Error, Converter={StaticResource ToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconTextStyle}" Margin="0,1,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{StaticResource Glyph.Error}" />
                    <TextBox Style="{x:Null}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{Binding Error, Mode=OneWay}"
                             AutomationProperties.Name="{x:Static res:Strings.Code_Error}"
                             AutomationProperties.AutomationId="Code.Error" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Margin="8,6,8,0">
            <avalonEdit:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True" WordWrap="False"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                   Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   LineNumbersForeground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   controls:CodeEditor.Code="{Binding Code}"
                                   controls:CodeEditor.Highlighting="{Binding Highlighting}"
                                   AutomationProperties.Name="{x:Static res:Strings.Code_Title}"
                                   AutomationProperties.AutomationId="Code.Editor">
                <avalonEdit:TextEditor.Resources>
                    <!-- AvalonEdit lists its margins (the line numbers) in an ItemsControl: named for screen readers (spec 11.8). -->
                    <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                        <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.Code_LineNumbers}" />
                        <Setter Property="AutomationProperties.AutomationId" Value="Code.LineNumbers" />
                    </Style>
                </avalonEdit:TextEditor.Resources>
            </avalonEdit:TextEditor>
            <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="{Binding Placeholder}"
                       Visibility="{Binding Placeholder, Converter={StaticResource ToVisibility}}"
                       AutomationProperties.AutomationId="Code.Empty" />
        </Grid>
    </DockPanel>
</UserControl>
