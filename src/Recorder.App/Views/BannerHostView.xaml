<UserControl x:Class="Recorder.App.Views.BannerHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources">
    <!-- Persistent conditions: target closed, elevation mismatch, shortcut taken. -->
    <ItemsControl ItemsSource="{Binding Banners.Items}" Focusable="False" AutomationProperties.AutomationId="Banners">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="8,8,8,0" Padding="12,8" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                        AutomationProperties.AutomationId="Banner"
                        AutomationProperties.Name="{Binding Message}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding DismissCommand}"
                                ToolTip="{x:Static res:Strings.Banner_Dismiss}"
                                AutomationProperties.Name="{x:Static res:Strings.Banner_Dismiss}"
                                AutomationProperties.AutomationId="Banner.Dismiss">
                            <TextBlock Style="{StaticResource IconTextStyle}" FontSize="10" Text="{StaticResource Glyph.Close}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="{Binding ActionText}"
                                Command="{Binding RunActionCommand}"
                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.AutomationId="Banner.Action" />
                        <TextBlock Style="{StaticResource IconTextStyle}" Margin="0,0,10,0" Text="&#xE946;" />
                        <TextBlock Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Text="{Binding Message}"
                                   AutomationProperties.AutomationId="Banner.Message" />
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
