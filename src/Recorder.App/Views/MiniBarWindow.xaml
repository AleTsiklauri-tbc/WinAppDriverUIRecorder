<Window x:Class="Recorder.App.Views.MiniBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Recorder.App.Resources"
        xmlns:views="clr-namespace:Recorder.App.Views"
        Title="{x:Static res:Strings.MiniBar_Name}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFontFamily}"
        AutomationProperties.Name="{x:Static res:Strings.MiniBar_Name}"
        AutomationProperties.AutomationId="MiniBar">
    <!-- DataContext: RecordingViewModel. Spec 11.4: never takes focus from the app being recorded; 60 % opaque unless hovered.
         Spec 11.5: while recording, toasts show under the pill (left-aligned, so the pill never moves when one is wider). -->
    <StackPanel>
        <Border x:Name="Pill" HorizontalAlignment="Left" CornerRadius="18" Padding="14,6" BorderThickness="1" Margin="6"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                MouseLeftButtonDown="OnDragStart">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0.6" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorCriticalBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsRecording}" Value="True" />
                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Pulse">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3"
                                                                 Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding MiniBarTitle}" MaxWidth="220" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="MiniBar.Title" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding ElapsedText}"
                           AutomationProperties.AutomationId="MiniBar.Elapsed" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StepCountText}"
                           AutomationProperties.AutomationId="MiniBar.Steps" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LastStepText}" ToolTip="{Binding LastStepText}"
                           AutomationProperties.AutomationId="MiniBar.LastStep" />
                <Button Margin="12,0,0,0" Padding="8,4" Command="{Binding TogglePauseCommand}" ToolTip="{Binding PauseTip}"
                        AutomationProperties.Name="{Binding PauseText}" AutomationProperties.AutomationId="MiniBar.Pause">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Pause}" />
                </Button>
                <Button Margin="4,0,0,0" Padding="8,4" Command="{Binding AssertCommand}" ToolTip="{Binding AssertTip}"
                        AutomationProperties.Name="{x:Static res:Strings.Toolbar_Assert}" AutomationProperties.AutomationId="MiniBar.Assert">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Assert}" />
                </Button>
                <Button Margin="4,0,0,0" Padding="8,4" Command="{Binding StopCommand}" ToolTip="{Binding [Toolbar_Stop_Tip], Source={StaticResource Shortcuts}}"
                        AutomationProperties.Name="{x:Static res:Strings.Toolbar_Stop}" AutomationProperties.AutomationId="MiniBar.Stop">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Stop}" />
                </Button>
            </StackPanel>
        </Border>
        <views:ToastHostView x:Name="ToastHost" HorizontalAlignment="Left" Margin="6,0,6,6" />
    </StackPanel>
</Window>
