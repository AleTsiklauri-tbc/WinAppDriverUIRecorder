<Window x:Class="Recorder.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Recorder.App.Resources"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="860" Height="580" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Closing="OnClosing"
        AutomationProperties.AutomationId="Settings">
    <!-- DataContext: SettingsViewModel. Spec 12: every change is saved and applied at once. -->
    <Window.Resources>
        <Style x:Key="NoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ProblemStyle" TargetType="TextBlock" BasedOn="{StaticResource NoteStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="GroupStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <!-- The sections come before Close in the tree, so Tab reaches them first. -->
    <Grid Margin="{StaticResource Space2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" TabStripPlacement="Left" SelectedIndex="{Binding Section, Converter={StaticResource EnumToIndex}}"
                    AutomationProperties.AutomationId="Settings.Sections">
            <TabItem Header="{x:Static res:Strings.Settings_Section_General}" AutomationProperties.AutomationId="Settings.Section.General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,12,12">
                        <CheckBox Content="{x:Static res:Strings.Settings_MinimizeOnRecord}" IsChecked="{Binding MinimizeOnRecord}"
                                  AutomationProperties.AutomationId="Settings.MinimizeOnRecord" />
                        <TextBlock Style="{StaticResource GroupStyle}" Text="{x:Static res:Strings.Settings_CodePane}" />
                        <RadioButton GroupName="CodePane" Content="{x:Static res:Strings.Settings_CodePane_Right}" IsChecked="{Binding CodePaneRight}"
                                     AutomationProperties.AutomationId="Settings.CodePane.Right" />
                        <RadioButton GroupName="CodePane" Content="{x:Static res:Strings.Settings_CodePane_Bottom}" IsChecked="{Binding CodePaneBottom}"
                                     AutomationProperties.AutomationId="Settings.CodePane.Bottom" />
                        <TextBlock Style="{StaticResource GroupStyle}" Text="{x:Static res:Strings.Settings_Theme}" />
                        <RadioButton GroupName="Theme" Content="{x:Static res:Strings.Settings_Theme_System}" IsChecked="{Binding ThemeSystem}"
                                     AutomationProperties.AutomationId="Settings.Theme.System" />
                        <RadioButton GroupName="Theme" Content="{x:Static res:Strings.Settings_Theme_Light}" IsChecked="{Binding ThemeLight}"
                                     AutomationProperties.AutomationId="Settings.Theme.Light" />
                        <RadioButton GroupName="Theme" Content="{x:Static res:Strings.Settings_Theme_Dark}" IsChecked="{Binding ThemeDark}"
                                     AutomationProperties.AutomationId="Settings.Theme.Dark" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Section_Shortcuts}" AutomationProperties.AutomationId="Settings.Section.Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,12,12">
                        <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_Shortcuts_Intro}" />
                        <ItemsControl ItemsSource="{Binding ShortcutRows}" Focusable="False" AutomationProperties.Name="{x:Static res:Strings.Settings_Section_Shortcuts}"
                                      AutomationProperties.AutomationId="Settings.Shortcuts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Name}" Margin="0,0,0,4" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_Shortcut_Reset}"
                                                    Command="{Binding ResetCommand}" ToolTip="{Binding ResetTip}"
                                                    AutomationProperties.Name="{Binding ResetTip}"
                                                    AutomationProperties.AutomationId="{Binding ResetAutomationId}" />
                                            <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False" FontFamily="{StaticResource MonoFontFamily}"
                                                     Text="{Binding Keys, Mode=OneWay}" PreviewKeyDown="OnShortcutKeyDown"
                                                     ToolTip="{x:Static res:Strings.Settings_Shortcut_Press}"
                                                     AutomationProperties.Name="{Binding Name}"
                                                     AutomationProperties.HelpText="{x:Static res:Strings.Settings_Shortcut_Press}"
                                                     AutomationProperties.AutomationId="{Binding AutomationId}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource ProblemStyle}" Text="{Binding Problem}"
                                                   Visibility="{Binding Problem, Converter={StaticResource ToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource NoteStyle}" Margin="0,16,0,0" Text="{x:Static res:Strings.Settings_Shortcut_Escape}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Section_Recording}" AutomationProperties.AutomationId="Settings.Section.Recording">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,12,12">
                        <CheckBox Content="{x:Static res:Strings.Settings_RecordSpecialKeys}" IsChecked="{Binding RecordSpecialKeys}"
                                  AutomationProperties.AutomationId="Settings.RecordSpecialKeys" />
                        <CheckBox Content="{x:Static res:Strings.Settings_MaskTypedValues}" IsChecked="{Binding MaskTypedValues}"
                                  AutomationProperties.AutomationId="Settings.MaskTypedValues" />
                        <CheckBox Content="{x:Static res:Strings.Settings_RecordScrolls}" IsChecked="{Binding RecordScrolls}"
                                  AutomationProperties.AutomationId="Settings.RecordScrolls" />
                        <TextBlock Style="{StaticResource NoteStyle}" Margin="0,12,0,0" Text="{x:Static res:Strings.Settings_Recording_Note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Section_Code}" AutomationProperties.AutomationId="Settings.Section.Code">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,12,12">
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.Settings_Profile}" />
                        <ComboBox HorizontalAlignment="Left" MinWidth="320" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{x:Static res:Strings.Settings_Profile}"
                                  AutomationProperties.AutomationId="Settings.Profile">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Margin="0,0,8,0" Content="{x:Static res:Strings.Settings_OpenProfilesFolder}" Command="{Binding OpenProfilesFolderCommand}"
                                    AutomationProperties.AutomationId="Settings.OpenProfilesFolder" />
                            <Button Content="{x:Static res:Strings.Settings_DuplicateProfile}" Command="{Binding DuplicateProfileCommand}"
                                    ToolTip="{x:Static res:Strings.Settings_DuplicateProfile_Tip}"
                                    AutomationProperties.AutomationId="Settings.DuplicateProfile" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource NoteStyle}" Margin="0,12,0,0" Text="{x:Static res:Strings.Settings_Profiles_Note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Section_WinAppDriver}" AutomationProperties.AutomationId="Settings.Section.WinAppDriver">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,12,12">
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.Settings_WinAppDriver_Address}" />
                        <TextBox HorizontalAlignment="Left" MinWidth="320" FontFamily="{StaticResource MonoFontFamily}"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="OnAddressLostFocus"
                                 ToolTip="{x:Static res:Strings.Settings_WinAppDriver_Address_Tip}"
                                 AutomationProperties.Name="{x:Static res:Strings.Settings_WinAppDriver_Address}"
                                 AutomationProperties.AutomationId="Settings.WinAppDriverAddress">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitAddressCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource ProblemStyle}" Text="{Binding AddressProblem}"
                                   Visibility="{Binding AddressProblem, Converter={StaticResource ToVisibility}}"
                                   AutomationProperties.AutomationId="Settings.WinAppDriverAddress.Problem" />
                        <CheckBox Margin="0,14,0,0" Content="{x:Static res:Strings.Settings_AllowRemote}" IsChecked="{Binding AllowRemote}"
                                  AutomationProperties.AutomationId="Settings.AllowRemote" />
                        <TextBlock Style="{StaticResource NoteStyle}" Text="{x:Static res:Strings.Settings_AllowRemote_Note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Section_Advanced}" AutomationProperties.AutomationId="Settings.Section.Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,0,12,12">
                        <CheckBox Content="{x:Static res:Strings.Settings_DetailedLogs}" IsChecked="{Binding DetailedLogs}"
                                  AutomationProperties.AutomationId="Settings.DetailedLogs" />
                        <Button HorizontalAlignment="Left" Margin="0,10,0,0" Content="{x:Static res:Strings.Settings_OpenLogsFolder}"
                                Command="{Binding OpenLogsFolderCommand}" AutomationProperties.AutomationId="Settings.OpenLogsFolder" />
                        <TextBlock Style="{StaticResource GroupStyle}" Text="{x:Static res:Strings.Settings_UiaTimeout}" />
                        <TextBox HorizontalAlignment="Left" Width="96" Text="{Binding UiaTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                 LostKeyboardFocus="OnUiaTimeoutLostFocus"
                                 AutomationProperties.Name="{x:Static res:Strings.Settings_UiaTimeout}"
                                 AutomationProperties.AutomationId="Settings.UiaTimeout">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitUiaTimeoutCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource ProblemStyle}" Text="{Binding UiaTimeoutProblem}"
                                   Visibility="{Binding UiaTimeoutProblem, Converter={StaticResource ToVisibility}}" />
                        <TextBlock Style="{StaticResource NoteStyle}" Text="{x:Static res:Strings.Settings_UiaTimeout_Note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" MinWidth="96" Content="{x:Static res:Strings.Settings_Close}" IsCancel="True"
                    AutomationProperties.AutomationId="Settings.Close" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Text="{x:Static res:Strings.Settings_Applied}" />
        </DockPanel>
    </Grid>
</Window>
