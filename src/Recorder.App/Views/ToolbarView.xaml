<UserControl x:Class="Recorder.App.Views.ToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources"
             xmlns:views="clr-namespace:Recorder.App.Views">
    <!-- Buttons whose features arrive in later phases are present (layout, AutomationIds, tooltips) but disabled. -->
    <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            AutomationProperties.AutomationId="Toolbar">
        <DockPanel LastChildFill="False">

            <Grid DockPanel.Dock="Left" Margin="0,0,12,0">
                <!-- Gentle pulse while choosing an app is the next thing to do; static when animations are off. -->
                <Border Margin="-3" BorderThickness="2" IsHitTestVisible="False"
                        CornerRadius="{StaticResource Radius}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FirstRun.IsTargetHighlighted}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding FirstRun.IsTargetHighlighted}" Value="True" />
                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Pulse">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                                 Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <ToggleButton x:Name="TargetButton" Style="{StaticResource {x:Type ToggleButton}}" Margin="0" Padding="10,6" MinHeight="32" MaxWidth="420"
                              IsChecked="{Binding Target.IsOpen}"
                              ToolTip="{x:Static res:Strings.Toolbar_Target_Tip}"
                              AutomationProperties.Name="{Binding Target.Caption}"
                              AutomationProperties.HelpText="{x:Static res:Strings.Toolbar_Target_Tip}"
                              AutomationProperties.AutomationId="Toolbar.TargetSelector">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Target}"
                                       Visibility="{Binding Target.CurrentIcon, Converter={StaticResource ToCollapsedVisibility}}" />
                            <Image Source="{Binding Target.CurrentIcon}" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Target.Caption}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Target.CurrentTitle}"
                                   Visibility="{Binding Target.CurrentTitle, Converter={StaticResource ToVisibility}}" />
                        <TextBlock Style="{StaticResource IconTextStyle}" Margin="8,0,0,0" FontSize="10" Text="{StaticResource Glyph.ChevronDown}" />
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding Target.IsOpen}" PlacementTarget="{Binding ElementName=TargetButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                    <views:TargetSelectorView DataContext="{Binding Target}" />
                </Popup>
            </Grid>

            <ToggleButton DockPanel.Dock="Left" Margin="0,0,4,0" Padding="10,6" MinHeight="32"
                          IsChecked="{Binding IsPicking}" IsEnabled="{Binding Recording.IsIdle}"
                          AutomationProperties.Name="{x:Static res:Strings.Toolbar_Pick}"
                          AutomationProperties.AutomationId="Toolbar.Pick">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="ToolTip" Value="{x:Static res:Strings.Toolbar_Pick_Tip}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                <Setter Property="ToolTip" Value="{x:Static res:Strings.Toolbar_Pick_Active_Tip}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe UI Symbol" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" Text="{StaticResource Glyph.Pick}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Toolbar_Pick}" />
                </StackPanel>
            </ToggleButton>
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding Recording.RecordCommand}"
                    ToolTip="{Binding [Toolbar_Record_Tip], Source={StaticResource Shortcuts}}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Record}"
                    AutomationProperties.AutomationId="Toolbar.Record">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{StaticResource Glyph.Record}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Toolbar_Record}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding Recording.TogglePauseCommand}"
                    ToolTip="{Binding Recording.PauseTip}"
                    AutomationProperties.Name="{Binding Recording.PauseText}"
                    AutomationProperties.AutomationId="Toolbar.Pause">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Pause}" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding Recording.StopCommand}"
                    ToolTip="{Binding [Toolbar_Stop_Tip], Source={StaticResource Shortcuts}}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Stop}"
                    AutomationProperties.AutomationId="Toolbar.Stop">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Stop}" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding Recording.AssertCommand}"
                    ToolTip="{Binding Recording.AssertTip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Assert}"
                    AutomationProperties.AutomationId="Toolbar.Assert">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" Margin="0,0,6,0" Text="{StaticResource Glyph.Assert}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Toolbar_Assert}" />
                </StackPanel>
            </Button>

            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Margin="0" Command="{Binding CheatSheet.ToggleCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_Help}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Help}"
                    AutomationProperties.AutomationId="Toolbar.Help">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Help}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenSettingsCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_Settings}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Settings}"
                    AutomationProperties.AutomationId="Toolbar.Settings">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Settings}" />
            </Button>
            <!-- Export ▾ holds the recording file commands (spec 11.9 Ctrl+S / Ctrl+O) and Export code (Ctrl+E): every class into a folder. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,12,0"
                    Click="OnExportClick"
                    ToolTip="{x:Static res:Strings.Toolbar_Export_Tip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Export}"
                    AutomationProperties.AutomationId="Toolbar.Export">
                <Button.ContextMenu>
                    <ContextMenu AutomationProperties.AutomationId="Toolbar.ExportMenu">
                        <MenuItem Header="{x:Static res:Strings.Menu_Save}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"
                                  AutomationProperties.AutomationId="Menu.Save" />
                        <MenuItem Header="{x:Static res:Strings.Menu_SaveAs}" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"
                                  AutomationProperties.AutomationId="Menu.SaveAs" />
                        <MenuItem Header="{x:Static res:Strings.Menu_Open}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"
                                  AutomationProperties.AutomationId="Menu.Open" />
                        <!-- The recordings saved or opened lately (spec 12); the full path shows as a tooltip. -->
                        <MenuItem Header="{x:Static res:Strings.Menu_OpenRecent}" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}"
                                  AutomationProperties.AutomationId="Menu.OpenRecent">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="CommandParameter" Value="{Binding Path}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.Menu_ExportCode}" InputGestureText="Ctrl+E" Command="{Binding Code.ExportCommand}"
                                  AutomationProperties.AutomationId="Menu.ExportCode" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" Margin="0,0,6,0" Text="{StaticResource Glyph.Export}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Toolbar_Export}" />
                    <TextBlock Style="{StaticResource IconTextStyle}" Margin="6,0,0,0" FontSize="10" Text="{StaticResource Glyph.ChevronDown}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding RedoCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_Redo_Tip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Redo}"
                    AutomationProperties.AutomationId="Toolbar.Redo">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Redo}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding UndoCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_Undo_Tip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_Undo}"
                    AutomationProperties.AutomationId="Toolbar.Undo">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="{StaticResource Glyph.Undo}" />
            </Button>
        </DockPanel>
    </Border>
</UserControl>
