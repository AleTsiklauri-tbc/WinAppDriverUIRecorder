<UserControl x:Class="Recorder.App.Views.TargetSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources"
             Width="440"
             AutomationProperties.AutomationId="TargetSelector">
    <!-- DataContext: TargetSelectorViewModel -->
    <Border Padding="8" BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        ToolTip="{x:Static res:Strings.TargetSelector_Refresh}"
                        AutomationProperties.Name="{x:Static res:Strings.TargetSelector_Refresh}"
                        AutomationProperties.AutomationId="TargetSelector.Refresh">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72C;" />
                </Button>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.TargetSelector_Search}"
                             AutomationProperties.AutomationId="TargetSelector.Search"
                             PreviewKeyDown="OnSearchKeyDown" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static res:Strings.TargetSelector_Search}"
                               Visibility="{Binding SearchText, Converter={StaticResource ToCollapsedVisibility}}" />
                </Grid>
            </DockPanel>

            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Style="{StaticResource SubtleButtonStyle}"
                    Content="{x:Static res:Strings.TargetSelector_Forget}"
                    Command="{Binding ForgetCommand}"
                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="TargetSelector.Forget" />

            <Grid MaxHeight="420">
                <!-- Each window is a button: click, Enter, Space and the UI Automation Invoke pattern all choose it. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="WindowList" ItemsSource="{Binding View}" Focusable="False"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  AutomationProperties.Name="{x:Static res:Strings.Toolbar_Target_Tip}"
                                  AutomationProperties.AutomationId="TargetSelector.List">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,8,4,2">
                                            <Image Width="16" Height="16" Margin="0,0,8,0"
                                                   Source="{Binding Items[0].Icon}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="24,4,4,4"
                                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="{Binding ProcessName}"
                                        AutomationProperties.AutomationId="TargetSelector.Window">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="{x:Static res:Strings.TargetSelector_Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="TargetSelector.Empty" />
                <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="{x:Static res:Strings.TargetSelector_NoMatch}"
                           Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
