<UserControl x:Class="Recorder.App.Views.ElementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recorder.App.Resources">
    <!-- DataContext: ElementsViewModel -->
    <Grid>
        <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="{x:Static res:Strings.Elements_Empty}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="Elements.Empty" />
        <DockPanel Visibility="{Binding IsEmpty, Converter={StaticResource ToCollapsedVisibility}}">
            <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:Strings.Elements_Filter}"
                         AutomationProperties.AutomationId="Elements.Filter" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static res:Strings.Elements_Filter}"
                           Visibility="{Binding FilterText, Converter={StaticResource ToCollapsedVisibility}}" />
            </Grid>
            <Grid>
                <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{x:Static res:Strings.Elements_Tab}"
                         AutomationProperties.AutomationId="Elements.List">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="4,10,4,2" FontWeight="SemiBold" Text="{Binding Name}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.InputBindings>
                        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,2">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{Binding Quality, Converter={StaticResource QualityBrush}}"
                                           Text="{Binding Quality, Converter={StaticResource QualityGlyph}}" ToolTip="{Binding TickTip}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorderStyle}" Margin="6,0,0,0"
                                        Background="{Binding Quality, Converter={StaticResource QualityBrush}}"
                                        Visibility="{Binding Badge, Converter={StaticResource ToVisibility}}">
                                    <TextBlock Text="{Binding Badge}" />
                                </Border>
                                <TextBlock Text="{Binding VariableName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding VariableName}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibleName}" />
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding TickTip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="{x:Static res:Strings.Elements_NoMatch}"
                           Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
