<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec 3 and 14 (Phase 6): one self-contained exe for Windows 10/11 x64, for PCs where installing .NET isn't allowed.
  ./build.ps1 publish writes artifacts/publish/win-x64/WinFormsRecorder.exe (ARCHITECTURE D-82).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs go inside the exe too; .NET unpacks them to %TEMP%\.net on first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompiled code: starts faster than compiling everything on first use. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
