<?xml version="1.0" encoding="utf-8"?>
<!-- api.nuget.org is not reachable from the corporate network; the Nexus group proxies it. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nexus-nuget-group" value="https://hdprepo.hq.tbc/repository/nuget-group/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
