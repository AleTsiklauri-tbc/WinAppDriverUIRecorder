<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Recorder.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Recorder.Core\Recorder.Core.csproj" />
  </ItemGroup>

  <!-- Build order only: the tests launch these executables; they are not referenced as assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\Recorder.SampleApp\Recorder.SampleApp.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\Recorder.App\Recorder.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
