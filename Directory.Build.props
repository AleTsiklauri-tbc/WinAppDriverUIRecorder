<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <Product>WinForms Recorder</Product>
    <Company>WinForms Recorder contributors</Company>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- NuGet.config points at the corporate Nexus feed, which is unreachable from outside that network. There, set the
       environment variable WINFORMSRECORDER_NUGET_SOURCE (e.g. https://api.nuget.org/v3/index.json) to restore from it instead (D-41). -->
  <PropertyGroup Condition="'$(WINFORMSRECORDER_NUGET_SOURCE)' != ''">
    <RestoreSources>$(WINFORMSRECORDER_NUGET_SOURCE)</RestoreSources>
  </PropertyGroup>
</Project>
